{
  "name": "mhwilds-skill-sim",
  "main": "cloudflare/mhwilds-skill-sim/src/index.mjs",
  "compatibility_date": "2026-07-14",
  "workers_dev": true,
  "build": {
    "command": "sh scripts/build-service-release.sh"
  },
  "assets": {
    "directory": ".build/service-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/game-guide/mhwilds-skill-sim", "/game-guide/mhwilds-inventory-checker", "/game-guide/mhwilds-skill-sim/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
