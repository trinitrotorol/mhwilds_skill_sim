{
  "name": "mhwilds-skill-sim-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:browser-solver": "vitest run src/browser-solver",
    "benchmark:browser-solver": "tsx src/browser-solver/benchmark-cli.ts",
    "install:browser-solver-chromium": "playwright install chromium",
    "certify:browser-solver": "tsx src/browser-solver/certification-cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "playwright": "1.61.1",
    "tsx": "4.22.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
