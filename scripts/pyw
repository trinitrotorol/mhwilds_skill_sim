#!/usr/bin/env sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
REPOSITORY_ROOT=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd -P)
mkdir -p "${REPOSITORY_ROOT}/.cache/pip" "${REPOSITORY_ROOT}/.cache/tmp" "${REPOSITORY_ROOT}/.cache/xdg/cache"
export PIP_CACHE_DIR="${REPOSITORY_ROOT}/.cache/pip"
export PIP_DISABLE_PIP_VERSION_CHECK=1
export TMPDIR="${REPOSITORY_ROOT}/.cache/tmp"
export TMP="${TMPDIR}" TEMP="${TMPDIR}"
export XDG_CACHE_HOME="${REPOSITORY_ROOT}/.cache/xdg/cache"
export PATH="${REPOSITORY_ROOT}/.venv/bin:${PATH}"
cd "${REPOSITORY_ROOT}"
exec "${REPOSITORY_ROOT}/.venv/bin/python" "$@"
